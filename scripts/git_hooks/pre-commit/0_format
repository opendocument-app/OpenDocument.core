#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == --about ]]; then
  echo "Checks formatting of staged C++ and Objective-C++ files."
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"
CLANG_FORMAT=${CLANG_FORMAT:-clang-format}
shopt -s nocasematch

git diff --cached --name-only --diff-filter=ACMRT -z |
  while IFS= read -r -d '' file; do
    case "$file" in
      *.cpp|*.cc|*.h|*.hpp|*.mm)
        mode=$(git --literal-pathspecs ls-files --stage -- "$file")
        [[ $mode == 120000\ * ]] && continue
        git show ":$file" |
          "$CLANG_FORMAT" --style=file --assume-filename="$file" --dry-run --Werror
        ;;
    esac
  done
