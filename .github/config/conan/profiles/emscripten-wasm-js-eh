{# The WebAssembly slice with exceptions in JavaScript, for the formula module
   that the native builds embed (`formula.yml`). Native wasm exceptions need
   Chrome 95, and an Android WebView can be older; a JavaScript exception
   loads anywhere, and costs size and speed.

   The EH mode is an ABI, so every dependency is built again in this mode.
   Conan leaves `tools.build:*flags` out of a package id, so the id has to
   name them, or the build would take the packages of `emscripten-wasm`. #}
include(emscripten-wasm)

[conf]
tools.build:cflags=['-fexceptions']
tools.build:cxxflags=['-fexceptions']
tools.build:exelinkflags=['-fexceptions']
tools.build:sharedlinkflags=['-fexceptions']
tools.info.package_id:confs=['tools.build:cflags', 'tools.build:cxxflags']
