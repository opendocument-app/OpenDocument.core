[settings]
arch=x86_64
build_type=Release
compiler=clang
compiler.version=20
compiler.cppstd=23
compiler.libcxx=libstdc++11
os=Linux

[conf]
tools.build:compiler_executables={'c': 'clang-20', 'cpp': 'clang++-20'}
tools.cmake.cmaketoolchain:extra_variables={'CMAKE_CXX_COMPILER_LAUNCHER': 'ccache', 'CMAKE_C_COMPILER_LAUNCHER': 'ccache'}

[buildenv]
CC=ccache clang-20
CXX=ccache clang++-20
