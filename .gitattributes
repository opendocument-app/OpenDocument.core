# Normalize text while preserving binary files.
* text=auto eol=lf

# Normalize source files.
*.c text
*.h text
*.py text

# Declare files that will always have CRLF line endings on checkout.
*.sln text eol=crlf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.pdf binary
*.jar binary
# Document fixtures must retain their exact bytes.
*.odt binary
*.ods binary
*.docx binary
